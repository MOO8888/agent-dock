{
  "name": "agent-dock",
  "version": "0.1.0",
  "private": true,
  "description": "Windows local workbench for coordinating official AI clients through their interfaces.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/server.mjs",
    "mcp": "node src/mcp.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "pack:source": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-source.ps1"
  },
  "license": "MIT"
}
